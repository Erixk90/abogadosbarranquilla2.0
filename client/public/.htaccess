# cPanel / Apache (LiteSpeed): SPA + canonicalizacion y seguridad
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1a. Forzar HTTPS (robusto detras de proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.abogadosbq.com%{REQUEST_URI} [R=301,L]

  # 1b. Forzar host canonical con www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.abogadosbq.com%{REQUEST_URI} [R=301,L]

  # 1c. Noticias prerenderizadas (HTML con OG propio para crawlers)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ /$1.html [L]

  # 2. Rutas validas del SPA -> index.html (200)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^$ /index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(noticias|admin)(/.*)?$ /index.html [L]
</IfModule>

# 3. Cualquier otra ruta devuelve 404 real (el SPA muestra "No encontrada")
ErrorDocument 404 /index.html

# 4. Headers de seguridad del sitio estatico
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-DNS-Prefetch-Control "off"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://api.abogadosbq.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.abogadosbq.com; media-src 'self' https://api.abogadosbq.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# Cache de larga duracion para assets versionados (hashed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|woff2|ico)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compresion gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
