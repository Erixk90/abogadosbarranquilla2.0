# Puerto en el que escucha la API (cPanel lo asigna vía .env de la app Node)
PORT=8787

# Contraseña de administración del CMS (obligatoria en producción)
ADMIN_PASSWORD=admin-bq

# Duración de la sesión en horas (por defecto 168 = 7 días)
SESSION_TTL_HOURS=168

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# En producción: el dominio del sitio, p. ej.: https://www.abogadosbq.com,https://abogadosbq.com
CORS_ORIGIN=

# Pon 1 solo si hay un proxy inverso de confianza (Apache/LiteSpeed de cPanel)
TRUST_PROXY=0
